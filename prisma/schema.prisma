generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String         @id @default(cuid())
  email     String         @unique
  password  String
  saved     SavedCollege[]
  createdAt DateTime       @default(now())
}

model College {
  id        String         @id @default(cuid())
  name      String
  location  String
  state     String
  type      String
  fees      Int
  rating    Float
  imageUrl  String?
  courses   Course[]
  placement Placement?
  reviews   Review[]
  savedBy   SavedCollege[]
  createdAt DateTime       @default(now())
}

model Course {
  id        String  @id @default(cuid())
  name      String
  duration  Int
  fees      Int
  college   College @relation(fields: [collegeId], references: [id])
  collegeId String
}

model Placement {
  id           String  @id @default(cuid())
  avgPackage   Float
  highestPkg   Float
  placementPct Float
  college      College @relation(fields: [collegeId], references: [id])
  collegeId    String  @unique
}

model Review {
  id        String   @id @default(cuid())
  rating    Float
  comment   String
  college   College  @relation(fields: [collegeId], references: [id])
  collegeId String
  createdAt DateTime @default(now())
}

model SavedCollege {
  id        String  @id @default(cuid())
  user      User    @relation(fields: [userId], references: [id])
  userId    String
  college   College @relation(fields: [collegeId], references: [id])
  collegeId String

  @@unique([userId, collegeId])
}